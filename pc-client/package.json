{
  "name": "phonetopccopycode-pc",
  "productName": "PhoneToPCCopyCode",
  "version": "1.0.0-beta.1",
  "description": "手机短信验证码 → PC 桥接：局域网接收、展示、上岛、复制到剪贴板",
  "main": "src/main/main.js",
  "author": "PhoneToPCCopyCode",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.phonetopc.copycode",
    "productName": "PhoneToPCCopyCode",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": ["dmg"],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage", "deb"],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}